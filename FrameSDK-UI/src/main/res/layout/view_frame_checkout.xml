<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/frame_surface"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/frame_surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/checkout"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/frame_text_primary"/>

            <ImageButton
                android:id="@+id/closeButton"
                android:layout_width="25dp"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/frame_surface_stroke"/>

        <com.framepayments.framesdk_ui.buttons.FrameGooglePayButton
            android:id="@+id/googlePayBtn"
            android:layout_marginTop="8dp"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:visibility="gone"
            tools:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"/>

        <LinearLayout
            android:id="@+id/googlePayDivider"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/frame_surface_stroke"/>
            <TextView android:text="@string/or"
                android:layout_height="20dp"
                android:layout_width="15dp"
                android:textColor="@color/frame_text_secondary"/>
            <View android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/frame_surface_stroke"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/existingPaymentOptionsScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="16dp"
            android:paddingBottom="0dp">

            <LinearLayout
                android:id="@+id/paymentOptionsContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/customerInfoContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:id="@+id/customer_information"
                android:text="@string/customer_information"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/frame_text_secondary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/customerInfoCompose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/newCardContainer"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <TextView
                android:id="@+id/card_information"
                android:text="@string/card_information"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/frame_text_secondary"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <com.framepayments.framesdk_ui.EncryptedPaymentCardInput
                android:id="@+id/encryptedCardInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/cardErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="?attr/colorError"
                android:layout_marginTop="2dp"
                android:visibility="gone"/>

            <LinearLayout
                android:id="@+id/customerAddressContainer"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/country_region"
                    android:text="@string/customer_address"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/frame_text_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/billingAddressCompose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <CheckBox
                android:id="@+id/saveCard"
                android:text="@string/save_for_future"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/frame_text_primary"/>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/payButton"
                android:text="@string/pay_amount"
                android:layout_marginTop="16dp"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:textStyle="bold"
                android:textColor="@color/frame_primary_button_text"
                android:backgroundTint="@color/frame_primary_button"/>

            <ProgressBar
                android:id="@+id/checkoutProgressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</ScrollView>
